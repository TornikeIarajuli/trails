# --- Required ---------------------------------------------------------------
# Supabase project URL and keys (Project Settings -> API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side only. Every database call uses it, so the API is the only
# authorization layer. Also accepted (as x-service-key) by the legacy
# cache-invalidation call from older admin panel deployments.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server -----------------------------------------------------------------
# Port to listen on (Render sets it). Default: 3000
PORT=3000
# "production" switches on JSON logs and Sentry.
NODE_ENV=development
# Sentry DSN; leave empty to disable error reporting.
SENTRY_DSN=
# Origin of the web admin panel, allowed by CORS (localhost:3000/3001 always are).
WEB_ADMIN_URL=

# --- Rate limiting ----------------------------------------------------------
# Header holding the real client IP, set by the edge in front of the app and not
# forgeable by clients. Default: cf-connecting-ip (Cloudflare in front of Render).
# "none" ignores all headers and uses Express' req.ip. X-Forwarded-For is never
# read directly.
CLIENT_IP_HEADER=cf-connecting-ip
# Reverse proxies Express trusts when it computes req.ip. Default: 1
TRUST_PROXY_HOPS=1

# --- Uploads ----------------------------------------------------------------
# Largest accepted upload in MB (photos and admin videos). Default: 12
MAX_UPLOAD_MB=12

# --- Hike verification (POST /api/completions/record) ---------------------
# A route vertex counts as passed when a track point is within this many meters.
# Default: 120
HIKE_TOLERANCE_M=120
# Share of route vertices (0-1) a track must pass to be approved. Default: 0.6
HIKE_MIN_COVERAGE=0.6
# Highest plausible average speed over the trail's distance, km/h. Default: 15
HIKE_MAX_SPEED_KMH=15

# --- Internal calls ---------------------------------------------------------
# Shared secret the web admin sends as x-internal-key to
# DELETE /api/trails/:id/cache. Optional: without it only the legacy
# x-service-key header works. Use a long random value, set the same value as
# INTERNAL_API_KEY in the admin panel.
INTERNAL_API_KEY=
