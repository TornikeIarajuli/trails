# Store text files with LF line endings; Git converts them on checkout as configured locally.
* text=auto

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.heic binary
*.heif binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp4 binary
*.mov binary
*.pdf binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
