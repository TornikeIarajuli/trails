# Admin panel environment. Copy to .env.local for local development and set the same names
# in the Vercel project. Never commit real values.

# Supabase project URL (https://<project-ref>.supabase.co). NEXT_PUBLIC_SUPABASE_URL is read as a fallback.
SUPABASE_URL=

# Supabase service-role key. Server-only: it bypasses row-level security.
# (The old name NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY still works but logs a warning; rename it.)
SUPABASE_SERVICE_ROLE_KEY=

# The single HTTP Basic sign-in for the panel. If either is missing the panel answers 503.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Base URL of the NestJS API, including /api. Optional; defaults to the production API.
BACKEND_URL=

# Shared secret the API expects in x-internal-key for DELETE /trails/:id/cache (same value as the
# API's INTERNAL_API_KEY). Optional: without it the panel sends the legacy x-service-key header.
INTERNAL_API_KEY=
