# Copy to `.env` (never commit real values). EXPO_PUBLIC_* variables are inlined
# into the JavaScript bundle at build time, so treat them as public.

# PostHog project API key. Leave empty to build without analytics.
EXPO_PUBLIC_POSTHOG_KEY=

# Backend API base URL, including the `/api` prefix.
# Leave empty to use the production API (https://trails-en04.onrender.com/api).
EXPO_PUBLIC_API_URL=
