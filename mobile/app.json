{
  "expo": {
    "name": "GZA",
    "slug": "mikiri-trails",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mikiri-trails",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7ad50ccb-dca8-474c-9958-4cdc628a0bab",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gzatrails.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GZA uses your location to show nearby trails, check you in at checkpoints and record your route while a hike is in progress, including when the screen is off.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GZA uses your location to record your route while a hike is in progress, including when the screen is off.",
        "NSCameraUsageDescription": "We need camera access to take proof photos at checkpoints.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to select proof photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gzatrails.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB9LkEbrdpx701TEGhJ_us8umTxMLXVe_Y"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GZA uses your location to record your route while a hike is in progress, including when the screen is off.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GZA to access your photos for proof submissions.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E20"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ad50ccb-dca8-474c-9958-4cdc628a0bab"
      }
    }
  }
}
